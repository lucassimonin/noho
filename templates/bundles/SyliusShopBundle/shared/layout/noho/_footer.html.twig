{# Footer Noho - Tailwind CSS #}
<footer class="bg-noho-dark text-white/80 py-16">
    <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
            {# Logo & Description #}
            <div class="md:col-span-2">
                <a href="{{ path('sylius_shop_homepage') }}" class="noho-logo inline-block mb-4">
                    <span class="font-noho-serif text-2xl font-normal tracking-tight text-white/90">NOHO</span>
                    <span class="text-[0.5rem] font-light tracking-[0.4em] uppercase text-white/60 ml-2">CONCIERGERIE</span>
                </a>
                <p class="text-sm text-white/60 leading-relaxed max-w-sm">
                    Une conciergerie haut de gamme à votre service. Simplicité, discrétion et excellence au quotidien.
                </p>
            </div>

            {# Navigation #}
            <div>
                <h4 class="text-xs font-medium tracking-widest uppercase text-white/40 mb-4">Navigation</h4>
                <ul class="space-y-2">
                    {% set taxons = sylius_shop_taxons_for_menu() %}
                    {% for taxon in taxons %}
                        <li>
                            <a href="{{ path('sylius_shop_product_index', {'slug': taxon.slug}) }}" 
                               class="text-sm text-white/70 hover:text-white transition-colors">
                                {{ taxon.name }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </div>

            {# Contact #}
            <div>
                <h4 class="text-xs font-medium tracking-widest uppercase text-white/40 mb-4">Contact</h4>
                <ul class="space-y-2 text-sm text-white/70">
                    <li>
                        <a href="{{ path('noho_espace_proprietaire') }}" class="hover:text-white transition-colors">
                            Espace Propriétaires
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('noho_experiences') }}" class="hover:text-white transition-colors">
                            Expériences
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        {# Bottom bar #}
        <div class="mt-12 pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4">
            <p class="text-xs text-white/40">
                &copy; {{ 'now'|date('Y') }} {{ sylius.channel.name }}. Tous droits réservés.
            </p>
            <div class="flex items-center gap-6">
                <a href="#" class="text-white/40 hover:text-white transition-colors">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                    </svg>
                </a>
            </div>
        </div>
    </div>
</footer>

{# Cart Offcanvas (Sylius hook) #}
{% hook 'offcanvas' with { _prefixes: prefixes|default(['sylius_shop.base']) } %}
