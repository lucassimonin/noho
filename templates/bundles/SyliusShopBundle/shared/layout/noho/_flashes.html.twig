{# Flash Messages - Tailwind CSS #}
{% if app.session is not null and app.session.started %}
    {% set flash_types = {
        'success': 'bg-green-50 border-green-200 text-green-800',
        'error': 'bg-red-50 border-red-200 text-red-800',
        'danger': 'bg-red-50 border-red-200 text-red-800',
        'info': 'bg-blue-50 border-blue-200 text-blue-800',
        'warning': 'bg-yellow-50 border-yellow-200 text-yellow-800'
    } %}
    
    {% set has_flashes = false %}
    {% for type in ['success', 'error', 'info', 'warning'] %}
        {% if app.session.flashbag.peek(type)|length > 0 %}
            {% set has_flashes = true %}
        {% endif %}
    {% endfor %}
    
    {% if has_flashes %}
        <div class="fixed top-32 left-0 right-0 z-40 pointer-events-none">
            <div class="container mx-auto px-4">
                {% for type in ['success', 'error', 'info', 'warning'] %}
                    {% for flash in app.session.flashbag.get(type) %}
                        {% set display_type = type == 'error' ? 'danger' : type %}
                        <div class="mb-2 p-4 border rounded-lg {{ flash_types[display_type] }} pointer-events-auto" role="alert">
                            <div class="flex justify-between items-start">
                                <div>
                                    <strong class="font-medium">{{ ('sylius.ui.' ~ type)|trans }}</strong>
                                    <p class="mt-1 text-sm">
                                        {% if flash is iterable %}
                                            {{ flash.message|trans(flash.parameters, 'flashes') }}
                                        {% else %}
                                            {{ flash|trans({}, 'flashes') }}
                                        {% endif %}
                                    </p>
                                </div>
                                <button type="button" class="text-current opacity-50 hover:opacity-100" onclick="this.parentElement.parentElement.remove()">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    {% endfor %}
                {% endfor %}
            </div>
        </div>
    {% endif %}
{% endif %}
