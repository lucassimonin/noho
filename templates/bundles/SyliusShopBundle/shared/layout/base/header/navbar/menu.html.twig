{# Noho Navigation Menu #}
{% set available_locales = sylius.channel.locales %}
{% set active_locale = app.request.locale %}
{% set locale_flags = {
    'fr_FR': '🇫🇷',
    'fr': '🇫🇷',
    'en_US': '🇬🇧',
    'en_GB': '🇬🇧',
    'en': '🇬🇧'
} %}
{% set locale_names = {
    'fr_FR': 'Français',
    'fr': 'Français',
    'en_US': 'English',
    'en_GB': 'English',
    'en': 'English'
} %}

<div class="w-100 border-bottom noho-nav-wrapper">
    {# Full-width mobile menu: no backdrop (sibling overlay was intercepting taps on iOS). #}
    <nav class="navbar offcanvas-lg offcanvas-start offcanvas-wide p-0" id="navbarNav" data-bs-backdrop="false">
        <div class="offcanvas-header">
            <button type="button" class="noho-close-btn" data-bs-dismiss="offcanvas" data-bs-target="#navbarNav" aria-label="Close">
                {{ 'noho.menu.close'|trans }}
            </button>
        </div>
        <div class="offcanvas-body w-full py-0 d-flex flex-column">

            {# ===== DESKTOP NAV (horizontal, centered) ===== #}
            <div class="navbar-nav my-2 flex-row gap-4 noho-main-nav d-none d-lg-flex justify-content-center" {{ sylius_test_html_attribute('menu') }}>
                {# Catalogue Mega Menu - Desktop #}
                {% if taxons|default([])|length > 0 %}
                <div class="noho-mega-dropdown">
                    <a href="{{ path('sylius_shop_product_index', {slug: 'catalogue'}) }}" class="nav-link noho-mega-trigger">
                        Catalogue
                        <svg width="10" height="6" viewBox="0 0 10 6" fill="currentColor" style="margin-left: 6px; transition: transform 0.2s;">
                            <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" fill="none"/>
                        </svg>
                    </a>
                    <div class="noho-mega-menu">
                        <div class="noho-mega-content">
                            {% for taxon in taxons %}
                                <div class="noho-mega-column">
                                    <a href="{{ path('sylius_shop_product_index', {slug: taxon.slug}) }}" class="noho-mega-title">{{ taxon.name }}</a>
                                    {% if taxon.enabledChildren|length > 0 %}
                                        <ul class="noho-mega-list">
                                            {% for child in taxon.enabledChildren %}
                                                <li><a href="{{ path('sylius_shop_product_index', {slug: child.slug}) }}">{{ child.name }}</a></li>
                                            {% endfor %}
                                        </ul>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
                {% endif %}
                <a href="{{ path('noho_experiences', { _locale: app.request.locale }) }}" class="nav-link">Expériences</a>
                <a href="{{ path('noho_espace_proprietaire', { _locale: app.request.locale }) }}" class="nav-link">Espace Propriétaires</a>
                <a href="{{ path('sylius_shop_contact_request') }}" class="nav-link">Contact</a>
            </div>

            {# ===== MOBILE NAV (vertical, full content) ===== #}
            <div class="d-lg-none noho-mobile-nav">
                {# Navigation links #}
                <div class="noho-mobile-nav-section">
                    <a href="{{ path('sylius_shop_homepage') }}" class="noho-mobile-nav-link">
                        {{ 'sylius.ui.home'|trans }}
                    </a>
                    <a href="{{ path('sylius_shop_product_index', {slug: 'catalogue'}) }}" class="noho-mobile-nav-link">
                        Catalogue
                    </a>
                    <a href="{{ path('noho_experiences', { _locale: app.request.locale }) }}" class="noho-mobile-nav-link">
                        Expériences
                    </a>
                    <a href="{{ path('noho_espace_proprietaire', { _locale: app.request.locale }) }}" class="noho-mobile-nav-link">
                        Espace Propriétaires
                    </a>
                    <a href="{{ path('sylius_shop_contact_request') }}" class="noho-mobile-nav-link">
                        Contact
                    </a>
                </div>

                {# Bottom section: Account + Language #}
                <div class="noho-mobile-bottom">
                    {# Account links - side by side #}
                    <div class="noho-mobile-account">
                        <a href="{{ path('sylius_shop_login') }}" class="noho-mobile-account-btn">
                            Connexion
                        </a>
                        <a href="{{ path('sylius_shop_register') }}" class="noho-mobile-account-btn noho-mobile-account-btn--outline">
                            Inscription
                        </a>
                    </div>

                    {# Language switcher #}
                    {% if available_locales|length > 1 %}
                    <div class="noho-mobile-lang">
                        {% for locale in available_locales %}
                            <a href="{{ path('sylius_shop_switch_locale', {'code': locale.code}) }}"
                               class="noho-mobile-lang-btn {% if locale.code == active_locale %}active{% endif %}">
                                <span>{{ locale_flags[locale.code]|default('🌐') }}</span>
                                <span>{{ locale_names[locale.code]|default(locale.code) }}</span>
                            </a>
                        {% endfor %}
                    </div>
                    {% endif %}
                </div>
            </div>

        </div>
    </nav>
</div>

<style>
/* Mega Menu Styles */
.noho-mega-dropdown {
    position: relative;
}

.noho-mega-trigger {
    display: inline-flex !important;
    align-items: center;
}

.noho-mega-trigger svg {
    transition: transform 0.3s ease;
}

.noho-mega-dropdown:hover .noho-mega-trigger svg {
    transform: rotate(180deg);
}

.noho-mega-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    z-index: 1000;
    padding-top: 20px;
}

.noho-mega-dropdown:hover .noho-mega-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
}

.noho-mega-content {
    display: flex;
    gap: 0;
    background: rgba(20, 20, 20, 0.98);
    backdrop-filter: blur(20px);
    border-radius: 16px;
    padding: 48px 32px;
    box-shadow: 0 25px 80px rgba(0,0,0,0.4);
}

.noho-mega-column {
    flex: 0 0 auto;
    padding: 0 40px;
    border-right: 1px solid rgba(255,255,255,0.08);
    white-space: nowrap;
}

.noho-mega-column:last-child {
    border-right: none;
}

.noho-mega-title {
    display: block;
    font-family: Georgia, serif;
    font-size: 1.2rem;
    font-weight: 400;
    color: #fff !important;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(255,255,255,0.12);
    text-decoration: none !important;
    transition: opacity 0.2s;
    letter-spacing: 0.02em;
}

.noho-mega-title:hover {
    opacity: 0.7;
    color: #fff !important;
}

.noho-mega-list {
    list-style: none;
    margin: 0;
    padding: 0;
}

.noho-mega-list li {
    margin-bottom: 6px;
}

.noho-mega-list a {
    display: block;
    font-size: 0.95rem;
    color: rgba(255,255,255,0.6) !important;
    text-decoration: none !important;
    padding: 10px 0;
    transition: all 0.2s ease;
    letter-spacing: 0.01em;
}

.noho-mega-list a:hover {
    color: #fff !important;
    padding-left: 10px;
    opacity: 1 !important;
}

/* Mobile styles */
@media (max-width: 991px) {
    .noho-mega-menu {
        position: static;
        transform: none;
        opacity: 1;
        visibility: visible;
        padding-top: 0;
        display: none;
    }

    .noho-mega-dropdown:hover .noho-mega-menu,
    .noho-mega-dropdown.active .noho-mega-menu {
        display: block;
    }

    .noho-mega-content {
        flex-direction: column;
        min-width: 100%;
        background: rgba(26, 26, 26, 0.95);
        border-radius: 8px;
        padding: 16px;
        margin-top: 8px;
    }

    .noho-mega-column {
        padding: 16px 0;
        border-right: none;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        min-width: auto;
    }

    .noho-mega-column:last-child {
        border-bottom: none;
    }
}

/* Mobile menu styles */
.noho-mobile-nav {
    padding: 32px 24px;
    flex: 1;
    display: flex;
    flex-direction: column;
}

.noho-mobile-nav-section {
    margin-bottom: 32px;
}

.noho-mobile-nav-link {
    display: block;
    padding: 18px 0;
    font-size: 1.1rem;
    font-weight: 500;
    color: #1a1a1a !important;
    text-decoration: none !important;
    border-bottom: 1px solid #f0f0f0;
    transition: opacity 0.2s;
    letter-spacing: 0.02em;
}

.noho-mobile-nav-link:first-child {
    padding-top: 0;
}

.noho-mobile-nav-link:last-child {
    border-bottom: none;
}

.noho-mobile-nav-link:hover {
    opacity: 0.6;
}

/* Bottom section - pushed to bottom */
.noho-mobile-bottom {
    margin-top: auto;
    padding-top: 32px;
    border-top: 1px solid #eee;
}

/* Account buttons - side by side */
.noho-mobile-account {
    display: flex;
    gap: 12px;
    margin-bottom: 20px;
}

.noho-mobile-account-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 14px 20px;
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none !important;
    border-radius: 8px;
    transition: all 0.2s;
    background: #1a1a1a;
    color: #fff !important;
}

.noho-mobile-account-btn:hover {
    background: #333;
}

.noho-mobile-account-btn--outline {
    background: #fff;
    color: #1a1a1a !important;
    border: 1px solid #1a1a1a;
}

.noho-mobile-account-btn--outline:hover {
    background: #f5f5f5;
}

/* Language switcher */
.noho-mobile-lang {
    display: flex;
    justify-content: center;
    gap: 10px;
}

.noho-mobile-lang-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    background: #f5f5f5;
    border: none;
    border-radius: 8px;
    color: #1a1a1a !important;
    text-decoration: none !important;
    font-size: 0.9rem;
    transition: all 0.2s;
}

.noho-mobile-lang-btn:hover {
    background: #eee;
}

.noho-mobile-lang-btn.active {
    background: #1a1a1a;
    color: #fff !important;
}
</style>
