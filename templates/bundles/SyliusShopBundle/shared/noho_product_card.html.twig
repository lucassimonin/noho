{# Product Card - Noho Luxury Style #}
{% set productUrl = path('sylius_shop_product_show', {'slug': product.slug, '_locale': product.translation.locale|default(app.request.locale)}) %}

{% if product.imagesByType('thumbnail') is not empty %}
    {% set image_path = product.imagesByType('thumbnail').first.path|imagine_filter('sylius_shop_product_thumbnail') %}
{% elseif product.images.first %}
    {% set image_path = product.images.first.path|imagine_filter('sylius_shop_product_thumbnail') %}
{% else %}
    {% set image_path = asset('bundles/syliusui/images/200x200.png') %}
{% endif %}

<article {{ sylius_test_html_attribute('product', product.code) }} class="noho-product-card" style="background: #fff; border-radius: 4px; overflow: hidden; transition: all 0.4s ease; box-shadow: 0 2px 8px rgba(0,0,0,0.06); max-width: 100%;" onmouseover="this.style.transform='translateY(-8px)'; this.style.boxShadow='0 20px 40px rgba(0,0,0,0.12)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 2px 8px rgba(0,0,0,0.06)';">
    <a href="{{ productUrl }}" style="display: block; text-decoration: none !important; color: inherit;">
        {# Image Container #}
        <div style="position: relative; aspect-ratio: 4/3; overflow: hidden; background: #f5f5f5;">
            <img src="{{ image_path }}" alt="{{ product.name }}" loading="lazy" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease;" onmouseover="this.style.transform='scale(1.08)';" onmouseout="this.style.transform='scale(1)';" />
            {# Overlay on hover #}
            <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.4) 0%, transparent 50%); opacity: 0; transition: opacity 0.3s ease;" class="card-overlay"></div>
        </div>

        {# Content #}
        <div style="padding: 20px 16px 24px;">
            {# Location tag #}
            {% if product.mainTaxon %}
            <div style="font-size: 0.7rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: #999; margin-bottom: 8px;">
                {{ product.mainTaxon.name }}
            </div>
            {% endif %}

            {# Title #}
            <h3 style="font-family: Georgia, 'Times New Roman', serif; font-size: 1.15rem; font-weight: 400; color: #1a1a1a !important; margin: 0 0 10px; line-height: 1.35; min-height: 2.7em;">
                {{ product.name }}
            </h3>

            {# Attributes: Guests, Rooms & Surface #}
            {% set attributesByLocale = product.getAttributesByLocale(app.request.locale, app.request.defaultLocale|default(app.request.locale), sylius_base_locale|default('en_US'))|default([]) %}
            {% set guests = null %}
            {% set rooms = null %}
            {% set surface = null %}
            {% for attrVal in attributesByLocale %}
                {% if attrVal.attribute.code is defined %}
                    {% if attrVal.attribute.code in ['personnes', 'voyageurs', 'travelers', 'capacity', 'guests'] %}
                        {% set guests = attrVal.value %}
                    {% endif %}
                    {% if attrVal.attribute.code in ['chambres', 'bedrooms', 'rooms'] %}
                        {% set rooms = attrVal.value %}
                    {% endif %}
                    {% if attrVal.attribute.code in ['surface', 'area', 'size'] %}
                        {% set surface = attrVal.value %}
                    {% endif %}
                {% endif %}
            {% endfor %}
            
            {% if guests or rooms or surface %}
            <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 12px; color: #666; font-size: 0.85rem;">
                {% if guests %}
                <div style="display: flex; align-items: center; gap: 5px;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                    <span>{{ guests }}</span>
                </div>
                {% endif %}
                {% if rooms %}
                <div style="display: flex; align-items: center; gap: 5px;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M3 7v11a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V7"/>
                        <path d="M21 10H3"/>
                        <path d="M6 4h12a2 2 0 0 1 2 2v1H4V6a2 2 0 0 1 2-2z"/>
                    </svg>
                    <span>{{ rooms }}</span>
                </div>
                {% endif %}
                {% if surface %}
                <div style="display: flex; align-items: center; gap: 5px;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <rect x="3" y="3" width="18" height="18" rx="2"/>
                        <path d="M3 9h18"/>
                        <path d="M9 3v18"/>
                    </svg>
                    <span>{{ surface }}m²</span>
                </div>
                {% endif %}
            </div>
            {% endif %}

            {# Price #}
            <div style="display: flex; align-items: baseline; gap: 8px; margin-bottom: 16px;">
                <span style="font-family: Georgia, serif; font-size: 1.1rem; font-weight: 400; color: #1a1a1a;">
                    {{ component('sylius_shop:product:price', { variant: variant, template: '@SyliusShop/product/common/price.html.twig' }) }}
                </span>
                <span style="font-size: 0.75rem; color: #999;">/nuit</span>
            </div>

            {# CTA #}
            <div style="display: flex; align-items: center; gap: 6px; font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; color: #1a1a1a !important; font-weight: 500;">
                <span>Découvrir</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
            </div>
        </div>
    </a>
</article>
