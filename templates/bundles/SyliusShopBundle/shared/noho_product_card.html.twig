{# Product Card - Noho Luxury Style #}
{% set productUrl = path('sylius_shop_product_show', {'slug': product.slug, '_locale': product.translation.locale|default(app.request.locale)}) %}

{% if product.imagesByType('thumbnail') is not empty %}
    {% set image_path = product.imagesByType('thumbnail').first.path|imagine_filter('sylius_shop_product_thumbnail') %}
{% elseif product.images.first %}
    {% set image_path = product.images.first.path|imagine_filter('sylius_shop_product_thumbnail') %}
{% else %}
    {% set image_path = asset('bundles/syliusui/images/200x200.png') %}
{% endif %}

<article {{ sylius_test_html_attribute('product', product.code) }} style="background: #fff; border-radius: 4px; overflow: hidden; transition: all 0.4s ease; box-shadow: 0 2px 8px rgba(0,0,0,0.06);" onmouseover="this.style.transform='translateY(-8px)'; this.style.boxShadow='0 20px 40px rgba(0,0,0,0.12)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 2px 8px rgba(0,0,0,0.06)';">
    <a href="{{ productUrl }}" style="display: block; text-decoration: none !important; color: inherit;">
        {# Image Container #}
        <div style="position: relative; aspect-ratio: 4/3; overflow: hidden; background: #f5f5f5;">
            <img src="{{ image_path }}" alt="{{ product.name }}" loading="lazy" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease;" onmouseover="this.style.transform='scale(1.08)';" onmouseout="this.style.transform='scale(1)';" />
            {# Overlay on hover #}
            <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.4) 0%, transparent 50%); opacity: 0; transition: opacity 0.3s ease;" class="card-overlay"></div>
        </div>
        
        {# Content #}
        <div style="padding: 20px 16px 24px;">
            {# Location tag #}
            {% if product.mainTaxon %}
            <div style="font-size: 0.7rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: #999; margin-bottom: 8px;">
                {{ product.mainTaxon.name }}
            </div>
            {% endif %}
            
            {# Title #}
            <h3 style="font-family: Georgia, 'Times New Roman', serif; font-size: 1.15rem; font-weight: 400; color: #1a1a1a !important; margin: 0 0 10px; line-height: 1.35; min-height: 2.7em;">
                {{ product.name }}
            </h3>
            
            {# Price #}
            <div style="display: flex; align-items: baseline; gap: 8px; margin-bottom: 16px;">
                <span style="font-family: Georgia, serif; font-size: 1.1rem; font-weight: 400; color: #1a1a1a;">
                    {{ component('sylius_shop:product:price', { variant: variant, template: '@SyliusShop/product/common/price.html.twig' }) }}
                </span>
                <span style="font-size: 0.75rem; color: #999;">/nuit</span>
            </div>
            
            {# CTA #}
            <div style="display: flex; align-items: center; gap: 6px; font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; color: #1a1a1a !important; font-weight: 500;">
                <span>Découvrir</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
            </div>
        </div>
    </a>
</article>
