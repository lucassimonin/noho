{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}{{ product.name }} | {{ parent() }}{% endblock %}

{% block content %}
{% set productImages = product.images %}
{% set mainImage = productImages.first %}
{% set imageOriginal = mainImage ? mainImage.path|imagine_filter('sylius_shop_product_original') : 'https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?w=1920&q=80' %}
{% set variant = product.enabledVariants|length > 0 ? product.enabledVariants.first : null %}
{% set attributesByLocale = product.getAttributesByLocale(app.request.locale, app.request.defaultLocale|default(app.request.locale), sylius_base_locale|default('en_US'))|default([])|sylius_sort_by('attribute.position') %}

{% set address = null %}
{% set lat = '48.8566' %}
{% set lng = '2.3522' %}
{% set personnesAttr = null %}
{% set chambresAttr = null %}
{% set surfaceAttr = null %}

{% for attrVal in attributesByLocale %}
    {% if attrVal.attribute.code is defined %}
        {% if attrVal.attribute.code in ['adresse', 'address', 'location'] %}{% set address = attrVal.value %}{% endif %}
        {% if attrVal.attribute.code in ['latitude', 'lat'] and attrVal.value is not empty %}{% set lat = attrVal.value %}{% endif %}
        {% if attrVal.attribute.code in ['longitude', 'lng'] and attrVal.value is not empty %}{% set lng = attrVal.value %}{% endif %}
        {% if attrVal.attribute.code in ['personnes', 'voyageurs', 'capacity'] %}{% set personnesAttr = attrVal %}{% endif %}
        {% if attrVal.attribute.code in ['chambres', 'bedrooms'] %}{% set chambresAttr = attrVal %}{% endif %}
        {% if attrVal.attribute.code in ['surface', 'area'] %}{% set surfaceAttr = attrVal %}{% endif %}
    {% endif %}
{% endfor %}

{% set destination = product.mainTaxon ? product.mainTaxon.name : 'Paris' %}
{% set address = address ?? 'Paris, France' %}

{# Hero Section #}
<section style="position: relative; min-height: 50vh; display: flex; align-items: center; justify-content: center; text-align: center; padding: 140px 24px 60px; color: #fff; background-color: #1a1a1a; background-image: url('{{ imageOriginal }}'); background-repeat: no-repeat; background-position: center center; background-size: cover;">
    <div style="position: absolute; inset: 0; background: rgba(0,0,0,0.4); z-index: 1;"></div>
    <div style="position: relative; z-index: 2;">
        <h1 style="font-family: Georgia, 'Times New Roman', serif; font-size: clamp(1.75rem, 4vw, 2.75rem); font-weight: 400; color: #fff !important; margin-bottom: 8px;">{{ product.name }}</h1>
        <p style="font-size: 1rem; color: rgba(255,255,255,0.9);">{{ destination }}</p>
    </div>
</section>

{# Main Content #}
<div style="max-width: 1200px; margin: 0 auto; padding: 60px 24px;">
    
    {# Breadcrumbs #}
    {% set taxon = product.mainTaxon %}
    {% set ancestors = noho_taxon_ancestors(taxon) %}
    <nav style="font-size: 0.85rem; color: #666; margin-bottom: 32px;">
        <a href="{{ path('sylius_shop_homepage') }}" style="color: #666 !important; text-decoration: none;">{{ 'noho.breadcrumb.home'|trans }}</a>
        
        {% if taxon %}
            {% for ancestor in ancestors %}
                <span style="margin: 0 8px; color: #ccc;">›</span>
                {% if ancestor.slug %}
                    <a href="{{ path('sylius_shop_product_index', {'slug': ancestor.slug}) }}" style="color: #666 !important; text-decoration: none;">{{ ancestor.name }}</a>
                {% else %}
                    <span style="color: #666;">{{ ancestor.name }}</span>
                {% endif %}
            {% endfor %}
            
            <span style="margin: 0 8px; color: #ccc;">›</span>
            <a href="{{ path('sylius_shop_product_index', {'slug': taxon.slug}) }}" style="color: #666 !important; text-decoration: none;">{{ taxon.name }}</a>
        {% endif %}
        
        <span style="margin: 0 8px; color: #ccc;">›</span>
        <span style="color: #1a1a1a; font-weight: 500;">{{ product.name }}</span>
    </nav>
    
    <div style="display: grid; grid-template-columns: 1fr 380px; gap: 60px; align-items: start;">
        
        {# Left Column - Gallery & Details #}
        <div>
            {# Image Carousel #}
            <div style="margin-bottom: 48px;">
                {# Main Image #}
                <div style="position: relative; aspect-ratio: 16/10; background: #f5f5f5; border-radius: 8px; overflow: hidden; margin-bottom: 12px;">
                    <img id="mainProductImage" src="{{ imageOriginal }}" alt="{{ product.name }}" style="width: 100%; height: 100%; object-fit: cover; transition: opacity 0.3s ease;" />
                </div>
                
                {# Thumbnails #}
                {% if productImages|length > 0 %}
                <div style="display: flex; gap: 8px; overflow-x: auto; padding-bottom: 8px;" id="thumbnailContainer">
                    {% for image in productImages %}
                        {% set thumbPath = image.path ? image.path|imagine_filter('sylius_shop_product_small_thumbnail') : asset('bundles/syliusui/images/200x200.png') %}
                        {% set largePath = image.path ? image.path|imagine_filter('sylius_shop_product_original') : thumbPath %}
                        <button type="button" 
                                class="thumb-btn{% if loop.first %} active{% endif %}"
                                data-src="{{ largePath }}"
                                style="flex-shrink: 0; width: 100px; height: 75px; border-radius: 6px; overflow: hidden; border: 2px solid {% if loop.first %}#1a1a1a{% else %}#e5e5e5{% endif %}; padding: 0; cursor: pointer; background: #f5f5f5; transition: border-color 0.2s;">
                            <img src="{{ thumbPath }}" alt="" style="width: 100%; height: 100%; object-fit: cover;" />
                        </button>
                    {% endfor %}
                </div>
                {% endif %}
            </div>

            {# Quick Info - Only show if there are attributes #}
            {% if personnesAttr or chambresAttr or surfaceAttr %}
            <div style="display: flex; gap: 32px; padding: 24px 0; border-top: 1px solid #eee; border-bottom: 1px solid #eee; margin-bottom: 40px;">
                {% if personnesAttr %}
                <div style="text-align: center;">
                    <div style="font-size: 1.5rem; font-weight: 600; color: #1a1a1a;">{{ personnesAttr.value }}</div>
                    <div style="font-size: 0.75rem; color: #999; text-transform: uppercase; letter-spacing: 0.08em;">{{ 'noho.product.guests'|trans }}</div>
                </div>
                {% endif %}
                {% if chambresAttr %}
                <div style="text-align: center;">
                    <div style="font-size: 1.5rem; font-weight: 600; color: #1a1a1a;">{{ chambresAttr.value }}</div>
                    <div style="font-size: 0.75rem; color: #999; text-transform: uppercase; letter-spacing: 0.08em;">{{ 'noho.product.bedrooms'|trans }}</div>
                </div>
                {% endif %}
                {% if surfaceAttr %}
                <div style="text-align: center;">
                    <div style="font-size: 1.5rem; font-weight: 600; color: #1a1a1a;">{{ surfaceAttr.value }}{{ 'noho.product.sqm'|trans }}</div>
                    <div style="font-size: 0.75rem; color: #999; text-transform: uppercase; letter-spacing: 0.08em;">{{ 'noho.product.surface'|trans }}</div>
                </div>
                {% endif %}
            </div>
            {% endif %}

            {# Description #}
            <div style="margin-bottom: 48px;">
                <h2 style="font-family: Georgia, serif; font-size: 1.5rem; font-weight: 400; color: #1a1a1a; margin-bottom: 20px;">{{ 'noho.product.description'|trans }}</h2>
                <div style="font-size: 1rem; line-height: 1.8; color: #555;">
                    {{ product.description|default("Cet appartement d'exception vous accueille dans un cadre raffiné, alliant le charme de l'ancien aux prestations contemporaines. Idéalement situé, il offre une expérience de séjour unique au cœur de la ville.")|nl2br }}
                </div>
            </div>

            {# Features Grid #}
            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 32px; margin-bottom: 48px;">
                <div>
                    <h3 style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: #999; margin-bottom: 12px;">Équipements</h3>
                    <ul style="list-style: none; padding: 0; margin: 0; font-size: 0.95rem; color: #555; line-height: 2;">
                        <li>✓ Wifi haut débit</li>
                        <li>✓ Cuisine équipée</li>
                        <li>✓ Climatisation</li>
                        <li>✓ Machine à laver</li>
                        <li>✓ TV connectée</li>
                    </ul>
                </div>
                <div>
                    <h3 style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: #999; margin-bottom: 12px;">Services inclus</h3>
                    <ul style="list-style: none; padding: 0; margin: 0; font-size: 0.95rem; color: #555; line-height: 2;">
                        <li>✓ Linge de maison</li>
                        <li>✓ Ménage final</li>
                        <li>✓ Accueil personnalisé</li>
                        <li>✓ Conciergerie 7j/7</li>
                        <li>✓ Assistance 24h/24</li>
                    </ul>
                </div>
            </div>

            {# Location #}
            <div>
                <h2 style="font-family: Georgia, serif; font-size: 1.5rem; font-weight: 400; color: #1a1a1a; margin-bottom: 20px;">Localisation</h2>
                <p style="font-size: 0.95rem; color: #666; margin-bottom: 16px;">{{ address }}</p>
                <div style="border-radius: 8px; overflow: hidden;">
                    <iframe
                        style="width: 100%; height: 300px; border: none; background: #f0f0f0;"
                        src="https://www.openstreetmap.org/export/embed.html?bbox={{ (lng|number_format(4,'.','') - 0.01) }},{{ (lat|number_format(4,'.','') - 0.008) }},{{ (lng|number_format(4,'.','') + 0.01) }},{{ (lat|number_format(4,'.','') + 0.008) }}&layer=mapnik&marker={{ lat }},{{ lng }}"
                        allowfullscreen
                        loading="lazy"
                        title="Localisation"
                    ></iframe>
                </div>
            </div>
        </div>

        {# Right Column - Booking Card #}
        <div style="position: sticky; top: 24px;">
            {# Price #}
            <div style="margin-bottom: 24px;">
                <div style="font-family: Georgia, serif; font-size: 2rem; color: #1a1a1a;">
                    {% if variant %}
                        {{ component('sylius_shop:product:price', { variant: variant, template: '@SyliusShop/product/show/content/info/summary/prices/price.html.twig' }) }}
                    {% else %}
                        Sur demande
                    {% endif %}
                </div>
                <div style="font-size: 0.85rem; color: #999;">par nuit • minimum 3 nuits</div>
            </div>

            {# Calendar #}
            <div style="background: #fff; border-radius: 12px; box-shadow: 0 4px 24px rgba(0,0,0,0.08); padding: 24px; margin-bottom: 24px;">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;">
                    <h3 style="font-family: Georgia, serif; font-size: 1.1rem; font-weight: 400; color: #1a1a1a; margin: 0;" id="calendarMonth">Mars 2026</h3>
                    <div style="display: flex; gap: 4px;">
                        <button type="button" id="prevMonth" style="width: 32px; height: 32px; border: 1px solid #e5e5e5; border-radius: 6px; background: #fff; cursor: pointer; display: flex; align-items: center; justify-content: center;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
                        </button>
                        <button type="button" id="nextMonth" style="width: 32px; height: 32px; border: 1px solid #e5e5e5; border-radius: 6px; background: #fff; cursor: pointer; display: flex; align-items: center; justify-content: center;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
                        </button>
                    </div>
                </div>
                
                {# Calendar Grid #}
                <div style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; text-align: center; font-size: 0.8rem;">
                    <div style="padding: 8px 4px; color: #999; font-weight: 500;">Lun</div>
                    <div style="padding: 8px 4px; color: #999; font-weight: 500;">Mar</div>
                    <div style="padding: 8px 4px; color: #999; font-weight: 500;">Mer</div>
                    <div style="padding: 8px 4px; color: #999; font-weight: 500;">Jeu</div>
                    <div style="padding: 8px 4px; color: #999; font-weight: 500;">Ven</div>
                    <div style="padding: 8px 4px; color: #999; font-weight: 500;">Sam</div>
                    <div style="padding: 8px 4px; color: #999; font-weight: 500;">Dim</div>
                </div>
                <div id="calendarDays" style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; text-align: center; font-size: 0.85rem;">
                    {# Days will be generated by JS #}
                </div>
            </div>

            {# Booking: Sylius cart + reservation dates #}
            <div style="background: #fff; border-radius: 12px; box-shadow: 0 4px 24px rgba(0,0,0,0.08); padding: 24px;">
                <h3 style="font-size: 0.7rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: #999; margin: 0 0 20px;">{{ 'noho.reservation.title'|trans }}</h3>

                {% if variant %}
                    {{ component('sylius_shop:product:add_to_cart_form', {
                        product: product,
                        template: '@SyliusShop/product/show/noho_add_to_cart.html.twig',
                        routeName: 'sylius_shop_cart_summary'
                    }) }}
                {% else %}
                    <p style="color: #666; font-size: 0.95rem;">{{ 'sylius.ui.out_of_stock'|trans }}</p>
                {% endif %}

                <div style="margin-top: 20px; padding-top: 20px; border-top: 1px solid #eee; text-align: center;">
                    <p style="font-size: 0.85rem; color: #999; margin-bottom: 4px;">Besoin d'une réponse rapide ?</p>
                    <a href="tel:+33756833888" style="font-size: 1rem; font-weight: 600; color: #1a1a1a !important; text-decoration: none;">+33 7 56 83 38 88</a>
                </div>
            </div>
        </div>
    </div>
</div>

{# Reviews Section #}
<section style="background: #f8f8f8; padding: 80px 0;">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 24px;">
        <h2 style="font-family: Georgia, serif; font-size: 1.75rem; font-weight: 400; color: #1a1a1a; text-align: center; margin-bottom: 48px;">Avis de nos voyageurs</h2>
        
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;">
            {% if product.acceptedReviews|length > 0 %}
                {% for review in product.acceptedReviews|slice(0, 3) %}
                    <div style="background: #fff; padding: 28px; border-radius: 8px;">
                        <p style="font-size: 0.95rem; color: #555; line-height: 1.7; font-style: italic; margin-bottom: 16px;">"{{ review.comment }}"</p>
                        <p style="font-size: 0.85rem; color: #1a1a1a; font-weight: 600;">— {{ review.author ? (review.author.firstName ?? review.author.email) : 'Anonyme' }}</p>
                    </div>
                {% endfor %}
            {% else %}
                <div style="background: #fff; padding: 28px; border-radius: 8px;">
                    <p style="font-size: 0.95rem; color: #555; line-height: 1.7; font-style: italic; margin-bottom: 16px;">"Le rooftop est incroyable. L'appartement est très propre, moderne et super bien équipé."</p>
                    <p style="font-size: 0.85rem; color: #1a1a1a; font-weight: 600;">— Clarine</p>
                </div>
                <div style="background: #fff; padding: 28px; border-radius: 8px;">
                    <p style="font-size: 0.95rem; color: #555; line-height: 1.7; font-style: italic; margin-bottom: 16px;">"Très bien situé, à deux pas du centre. Mention spéciale pour la vue panoramique."</p>
                    <p style="font-size: 0.85rem; color: #1a1a1a; font-weight: 600;">— Benoit</p>
                </div>
                <div style="background: #fff; padding: 28px; border-radius: 8px;">
                    <p style="font-size: 0.95rem; color: #555; line-height: 1.7; font-style: italic; margin-bottom: 16px;">"The kids loved the terrace. Everything is thoughtfully set up."</p>
                    <p style="font-size: 0.85rem; color: #1a1a1a; font-weight: 600;">— Dave</p>
                </div>
            {% endif %}
        </div>
    </div>
</section>

<style>
.thumb-btn.active { border-color: #1a1a1a !important; }
.thumb-btn:hover { border-color: #999 !important; }
.cal-day { padding: 10px 4px; cursor: pointer; border-radius: 4px; transition: background 0.15s; }
.cal-day:hover { background: #f5f5f5; }
.cal-day.disabled { color: #ccc; cursor: default; }
.cal-day.disabled:hover { background: transparent; }
.cal-day.selected { background: #1a1a1a; color: #fff; }
.cal-day.in-range { background: #f0f0f0; }

@media (max-width: 900px) {
    [style*="grid-template-columns: 1fr 380px"] { grid-template-columns: 1fr !important; }
    [style*="grid-template-columns: repeat(3, 1fr)"] { grid-template-columns: 1fr !important; }
}
</style>

<script>
(function() {
    // Thumbnail Gallery
    var thumbs = document.querySelectorAll('.thumb-btn');
    var mainImg = document.getElementById('mainProductImage');
    
    thumbs.forEach(function(btn) {
        btn.addEventListener('click', function() {
            thumbs.forEach(function(b) { b.classList.remove('active'); });
            btn.classList.add('active');
            mainImg.style.opacity = '0.5';
            setTimeout(function() {
                mainImg.src = btn.getAttribute('data-src');
                mainImg.style.opacity = '1';
            }, 150);
        });
    });

    // Calendar — resolve date inputs (explicit id or Sylius-generated name)
    function nohoReservationStartInput() {
        var byId = document.getElementById('arrivalDate');
        if (byId) return byId;
        return document.querySelector('input[name="sylius_shop_add_to_cart[reservationStartAt]"]')
            || document.querySelector('input[name*="[reservationStartAt]"]');
    }
    function nohoReservationEndInput() {
        var byId = document.getElementById('departureDate');
        if (byId) return byId;
        return document.querySelector('input[name="sylius_shop_add_to_cart[reservationEndAt]"]')
            || document.querySelector('input[name*="[reservationEndAt]"]');
    }

    // Calendar
    var currentDate = new Date();
    var currentMonth = currentDate.getMonth();
    var currentYear = currentDate.getFullYear();
    var selectedStart = null;
    var selectedEnd = null;
    
    var monthNames = ['Janvier', 'Février', 'Mars', 'Avril', 'Mai', 'Juin', 'Juillet', 'Août', 'Septembre', 'Octobre', 'Novembre', 'Décembre'];

    /** ES5-safe (padStart missing on older Safari / WebViews) */
    function pad2(n) {
        var s = String(n);
        return s.length < 2 ? '0' + s : s;
    }
    
    // Helper to format date as YYYY-MM-DD without timezone issues
    function formatDate(year, month, day) {
        return year + '-' + pad2(month + 1) + '-' + pad2(day);
    }
    
    // Helper to create date without timezone issues
    function createLocalDate(year, month, day) {
        var d = new Date(year, month, day, 12, 0, 0);
        return d;
    }
    
    function renderCalendar() {
        var firstDay = new Date(currentYear, currentMonth, 1);
        var lastDay = new Date(currentYear, currentMonth + 1, 0);
        var startDay = firstDay.getDay() || 7;
        var daysInMonth = lastDay.getDate();
        var today = new Date();
        today.setHours(0,0,0,0);
        
        document.getElementById('calendarMonth').textContent = monthNames[currentMonth] + ' ' + currentYear;
        
        var html = '';
        
        // Empty cells for days before month starts
        for (var i = 1; i < startDay; i++) {
            html += '<div class="cal-day disabled"></div>';
        }
        
        // Days of month
        for (var day = 1; day <= daysInMonth; day++) {
            var date = createLocalDate(currentYear, currentMonth, day);
            var dateStr = formatDate(currentYear, currentMonth, day);
            var isPast = date < today;
            var isSelected = (selectedStart && dateStr === selectedStart) || 
                            (selectedEnd && dateStr === selectedEnd);
            
            var isInRange = false;
            if (selectedStart && selectedEnd) {
                isInRange = dateStr > selectedStart && dateStr < selectedEnd;
            }
            
            var classes = 'cal-day';
            if (isPast) classes += ' disabled';
            if (isSelected) classes += ' selected';
            if (isInRange) classes += ' in-range';
            
            html += '<div class="' + classes + '" data-date="' + dateStr + '" data-day="' + day + '">' + day + '</div>';
        }
        
        document.getElementById('calendarDays').innerHTML = html;
        
        // Add click handlers
        document.querySelectorAll('.cal-day:not(.disabled)').forEach(function(el) {
            el.addEventListener('click', function() {
                var dateStr = this.getAttribute('data-date');
                
                var arrIn = nohoReservationStartInput();
                var depIn = nohoReservationEndInput();
                if (!selectedStart || (selectedStart && selectedEnd)) {
                    selectedStart = dateStr;
                    selectedEnd = null;
                    if (arrIn) arrIn.value = dateStr;
                    if (depIn) depIn.value = '';
                } else {
                    if (dateStr > selectedStart) {
                        selectedEnd = dateStr;
                        if (depIn) depIn.value = dateStr;
                    } else {
                        selectedStart = dateStr;
                        if (arrIn) arrIn.value = dateStr;
                    }
                }
                renderCalendar();
            });
        });
    }
    
    document.getElementById('prevMonth').addEventListener('click', function() {
        currentMonth--;
        if (currentMonth < 0) { currentMonth = 11; currentYear--; }
        renderCalendar();
    });
    
    document.getElementById('nextMonth').addEventListener('click', function() {
        currentMonth++;
        if (currentMonth > 11) { currentMonth = 0; currentYear++; }
        renderCalendar();
    });
    
    renderCalendar();
})();
</script>
{% endblock %}
