{# Live component: sylius_shop:product:add_to_cart_form #}
{% import '@SyliusShop/shared/macro/loader.html.twig' as loader %}

{% form_theme form '@SyliusShop/form/theme.html.twig' %}

<div class="position-relative" {{ attributes }}>
    {% if product.enabledVariants.empty() or product.simple and not sylius_inventory_is_available(product.enabledVariants.first) %}
        <div {{ sylius_test_html_attribute('product-out-of-stock') }}>{{ 'sylius.ui.out_of_stock'|trans }}</div>
    {% else %}
        {{ loader.render() }}
        <div {{ sylius_test_html_attribute('product-selecting-variant') }}>
            {{ form_start(form, {'attr': {'data-action': 'live#action:prevent live#$render', 'data-live-action-param': 'addToCart'}}) }}
            {{ form_errors(form) }}

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px;">
                {% if form.reservationStartAt is defined %}
                    {{ form_row(form.reservationStartAt, {'attr': {'id': 'arrivalDate'}}) }}
                {% endif %}
                {% if form.reservationEndAt is defined %}
                    {{ form_row(form.reservationEndAt, {'attr': {'id': 'departureDate'}}) }}
                {% endif %}
            </div>

            {% if form.cartItem.variant is defined %}
                {{ form_row(form.cartItem.variant) }}
            {% endif %}

            <div style="display: none;">
                {{ form_widget(form.cartItem.quantity) }}
            </div>

            <button type="submit" class="noho-btn-submit" style="width: 100%; padding: 16px; font-size: 0.9rem; font-weight: 500; letter-spacing: 0.05em; text-transform: uppercase; color: #fff; background: #1a1a1a; border: none; border-radius: 6px; cursor: pointer;">
                {{ 'noho.reservation.add_to_cart'|trans }}
            </button>

            {{ form_row(form._token) }}
            {{ form_end(form, {'render_rest': false}) }}
        </div>
    {% endif %}
</div>
