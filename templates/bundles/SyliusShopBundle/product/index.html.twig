{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block content %}
<style>
/* Page liste – même header que l’accueil et la fiche produit (overlay transparent, texte blanc) */
body[data-route="sylius_shop_product_index"] { margin: 0; padding: 0; }
body[data-route="sylius_shop_product_index"] .d-flex.min-vh-100 { padding-top: 0 !important; margin-top: 0 !important; }
body[data-route="sylius_shop_product_index"] .d-flex.min-vh-100 > *:nth-child(1) { position: absolute; top: 0; left: 0; right: 0; background: transparent !important; border: none !important; color: #fff; z-index: 20; margin-top: 0 !important; }
body[data-route="sylius_shop_product_index"] .d-flex.min-vh-100 > *:nth-child(1) a { color: #fff !important; }
body[data-route="sylius_shop_product_index"] .d-flex.min-vh-100 > *:nth-child(1) .noho-logo__main { color: #fff !important; }
body[data-route="sylius_shop_product_index"] .d-flex.min-vh-100 > *:nth-child(1) .noho-logo__sub { color: rgba(255,255,255,0.9) !important; }
body[data-route="sylius_shop_product_index"] .d-flex.min-vh-100 > *:nth-child(2) { position: absolute; top: 64px; left: 0; right: 0; background: transparent !important; border: none !important; color: #fff; z-index: 20; }
body[data-route="sylius_shop_product_index"] .d-flex.min-vh-100 > *:nth-child(2) .nav-link { color: #fff !important; }
body[data-route="sylius_shop_product_index"] .d-flex.min-vh-100 > *:nth-child(2) .navbar-nav .nav-link:hover { color: rgba(255,255,255,0.85) !important; }
body[data-route="sylius_shop_product_index"] .d-flex.min-vh-100 > *:nth-child(2) .btn-close { filter: invert(1); }
body[data-route="sylius_shop_product_index"] .d-flex.min-vh-100 > *:nth-child(2) a,
body[data-route="sylius_shop_product_index"] .d-flex.min-vh-100 > *:nth-child(2) span { color: #fff !important; }
/* Supprimer l’espace blanc : bloc flashes (messages) ne réserve pas de place quand vide */
body[data-route="sylius_shop_product_index"] .d-flex.min-vh-100 > *:nth-child(3) { position: absolute !important; top: 130px; left: 0; right: 0; z-index: 10; margin: 0 !important; padding: 0 !important; min-height: 0 !important; }
body[data-route="sylius_shop_product_index"] .d-flex.min-vh-100 > *:nth-child(2),
body[data-route="sylius_shop_product_index"] .d-flex.min-vh-100 > *:nth-child(4) { margin-top: 0 !important; padding-top: 0 !important; }

.noho-list-hero { position: relative; min-height: 45vh; display: flex; align-items: center; justify-content: center; text-align: center; padding: 160px 1.5rem 4rem; color: #fff; background: #1a1a1a no-repeat center center / cover; }
.noho-list-hero::before { content: ''; position: absolute; inset: 0; background: rgba(0,0,0,0.4); z-index: 0; }
.noho-list-hero__inner { position: relative; z-index: 1; }
.noho-list-hero__title { font-family: Georgia, 'Times New Roman', serif; font-size: clamp(1.75rem, 4vw, 2.75rem); font-weight: 400; letter-spacing: 0.02em; line-height: 1.3; margin: 0; text-shadow: 0 2px 20px rgba(0,0,0,0.3); }

/* Page liste – grille + sidebar à gauche (filtres) */
{% include '@SyliusShop/shared/_product_grid_styles.html.twig' %}
.noho-list-section { padding: 2rem 0 4rem; }
body[data-route="sylius_shop_product_index"] .noho-list-section { margin-top: 0 !important; padding-top: 0 !important; }
.noho-list-section--light { background: #fafafa; }
.noho-list-desc { font-size: 1rem; color: #555; line-height: 1.6; margin-bottom: 1.5rem; }
.noho-list-count { font-size: 0.9rem; color: #555; margin-bottom: 1.25rem; }
.noho-list-breadcrumbs { font-size: 0.85rem; color: #888; margin-bottom: 1.5rem; }
.noho-list-breadcrumbs a { color: #1a1a1a; text-decoration: none; }
.noho-list-breadcrumbs a:hover { text-decoration: underline; }
.noho-list-sidebar { font-size: 0.9rem; color: #555; }
.noho-list-sidebar .nav-link { color: #555; padding: 0.35rem 0; }
.noho-list-sidebar .nav-link:hover { color: #1a1a1a; }
.noho-list-sidebar-title { font-family: Georgia, 'Times New Roman', serif; font-size: 0.95rem; font-weight: 600; letter-spacing: 0.05em; color: #1a1a1a; margin-bottom: 1rem; text-transform: uppercase; }
.noho-list-filters { display: flex; flex-direction: column; gap: 1rem; }
.noho-list-filters .form-select, .noho-list-filters .form-control { border-radius: 6px; border-color: #ddd; font-size: 0.9rem; width: 100%; }
.noho-list-sidebar-filters .col { flex: 0 0 100%; max-width: 100%; }
.noho-list-sidebar-filters .col-auto { flex: 0 0 100%; max-width: 100%; }
.noho-list-sidebar-filters .d-flex { flex-direction: column; align-items: stretch; }
.noho-list-sidebar-filters .input-group { flex-wrap: wrap; }
.noho-list-pagination { margin-top: 2.5rem; }
/* Masquer uniquement le header vide (titre déjà dans le hero) */
.noho-list-main-col .noho-list-hide-in-main { display: none !important; }
/* Barre de filtres : une ligne au-dessus de la grille (comme avant), style Noho */
.noho-list-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid #eee; }
.noho-list-bar .noho-list-filters { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; }
.noho-list-bar .noho-list-filters .row { margin: 0; }
.noho-list-bar .noho-list-filters .col { flex: 0 0 auto; }
.noho-list-bar .noho-list-filters .col-auto { flex: 0 0 auto; }
.noho-list-bar .noho-list-count { font-size: 0.9rem; color: #555; }
/* Hero pleine largeur même dans .container */
.container .noho-list-hero { width: 100vw; max-width: 100vw; margin-left: calc(-50vw + 50%); }
@media (max-width: 768px) { .noho-list-hero { min-height: 35vh; padding: 140px 1rem 3rem; } body[data-route="sylius_shop_product_index"] .d-flex.min-vh-100 > *:nth-child(2) { top: 56px; } }
</style>

<section class="noho-list-section noho-list-section--light">
    {% hook 'sylius_shop.product.index' with { products, resources } %}
</section>
{% endblock %}
