{# Sidebar with Filters #}
{% set taxon = noho_current_taxon() %}

<aside style="width: 280px; flex-shrink: 0; position: sticky; top: 24px;">
    <div style="background: #fff; border-radius: 12px; padding: 28px; box-shadow: 0 2px 12px rgba(0,0,0,0.06);">
        <h3 style="font-family: Georgia, serif; font-size: 1.1rem; font-weight: 600; color: #1a1a1a; margin: 0 0 24px; padding-bottom: 16px; border-bottom: 1px solid #eee;">{{ 'noho.filters.title'|trans }}</h3>
        
        {# Price Filter #}
        <div style="margin-bottom: 28px;">
            <h4 style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: #999; margin: 0 0 14px;">{{ 'noho.filters.price_per_night'|trans }}</h4>
            <div style="display: flex; flex-direction: column; gap: 8px;">
                <label style="display: flex; align-items: center; gap: 10px; font-size: 0.9rem; color: #1a1a1a; cursor: pointer;">
                    <input type="checkbox" name="price[]" value="0-500" style="width: 18px; height: 18px; accent-color: #1a1a1a;">
                    {{ 'noho.filters.price_under_500'|trans }}
                </label>
                <label style="display: flex; align-items: center; gap: 10px; font-size: 0.9rem; color: #1a1a1a; cursor: pointer;">
                    <input type="checkbox" name="price[]" value="500-1000" style="width: 18px; height: 18px; accent-color: #1a1a1a;">
                    {{ 'noho.filters.price_500_1000'|trans }}
                </label>
                <label style="display: flex; align-items: center; gap: 10px; font-size: 0.9rem; color: #1a1a1a; cursor: pointer;">
                    <input type="checkbox" name="price[]" value="1000-2000" style="width: 18px; height: 18px; accent-color: #1a1a1a;">
                    {{ 'noho.filters.price_1000_2000'|trans }}
                </label>
                <label style="display: flex; align-items: center; gap: 10px; font-size: 0.9rem; color: #1a1a1a; cursor: pointer;">
                    <input type="checkbox" name="price[]" value="2000+" style="width: 18px; height: 18px; accent-color: #1a1a1a;">
                    {{ 'noho.filters.price_over_2000'|trans }}
                </label>
            </div>
        </div>
        
        {# Bedrooms Filter - Single row #}
        <div style="margin-bottom: 28px;">
            <h4 style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: #999; margin: 0 0 14px;">{{ 'noho.search.rooms'|trans }}</h4>
            <div style="display: flex; gap: 6px;">
                <button type="button" class="filter-btn" style="flex: 1; padding: 10px 0; font-size: 0.85rem; color: #1a1a1a; background: #f5f5f5; border: 1px solid #e5e5e5; border-radius: 6px; cursor: pointer; transition: all 0.2s;">1</button>
                <button type="button" class="filter-btn" style="flex: 1; padding: 10px 0; font-size: 0.85rem; color: #1a1a1a; background: #f5f5f5; border: 1px solid #e5e5e5; border-radius: 6px; cursor: pointer; transition: all 0.2s;">2</button>
                <button type="button" class="filter-btn" style="flex: 1; padding: 10px 0; font-size: 0.85rem; color: #1a1a1a; background: #f5f5f5; border: 1px solid #e5e5e5; border-radius: 6px; cursor: pointer; transition: all 0.2s;">3</button>
                <button type="button" class="filter-btn" style="flex: 1; padding: 10px 0; font-size: 0.85rem; color: #1a1a1a; background: #f5f5f5; border: 1px solid #e5e5e5; border-radius: 6px; cursor: pointer; transition: all 0.2s;">4</button>
                <button type="button" class="filter-btn" style="flex: 1; padding: 10px 0; font-size: 0.85rem; color: #1a1a1a; background: #f5f5f5; border: 1px solid #e5e5e5; border-radius: 6px; cursor: pointer; transition: all 0.2s;">5+</button>
            </div>
        </div>
        
        {# Guests Filter - Single row #}
        <div style="margin-bottom: 28px;">
            <h4 style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: #999; margin: 0 0 14px;">{{ 'noho.search.travelers'|trans }}</h4>
            <div style="display: flex; gap: 6px;">
                <button type="button" class="filter-btn" style="flex: 1; padding: 10px 0; font-size: 0.85rem; color: #1a1a1a; background: #f5f5f5; border: 1px solid #e5e5e5; border-radius: 6px; cursor: pointer; transition: all 0.2s;">1</button>
                <button type="button" class="filter-btn" style="flex: 1; padding: 10px 0; font-size: 0.85rem; color: #1a1a1a; background: #f5f5f5; border: 1px solid #e5e5e5; border-radius: 6px; cursor: pointer; transition: all 0.2s;">2</button>
                <button type="button" class="filter-btn" style="flex: 1; padding: 10px 0; font-size: 0.85rem; color: #1a1a1a; background: #f5f5f5; border: 1px solid #e5e5e5; border-radius: 6px; cursor: pointer; transition: all 0.2s;">3</button>
                <button type="button" class="filter-btn" style="flex: 1; padding: 10px 0; font-size: 0.85rem; color: #1a1a1a; background: #f5f5f5; border: 1px solid #e5e5e5; border-radius: 6px; cursor: pointer; transition: all 0.2s;">4</button>
                <button type="button" class="filter-btn" style="flex: 1; padding: 10px 0; font-size: 0.85rem; color: #1a1a1a; background: #f5f5f5; border: 1px solid #e5e5e5; border-radius: 6px; cursor: pointer; transition: all 0.2s;">5+</button>
            </div>
        </div>
        
        {# Dates Filter with Custom Date Picker #}
        <div style="margin-bottom: 28px; position: relative;">
            <h4 style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: #999; margin: 0 0 14px;">{{ 'noho.search.dates'|trans }}</h4>
            
            {# Date display trigger #}
            <div id="filterDateTrigger" style="padding: 14px; background: #f8f8f8; border: 1px solid #e5e5e5; border-radius: 8px; cursor: pointer; transition: border-color 0.2s;">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span id="filterDateDisplay" style="font-size: 0.9rem; color: #666;">{{ 'noho.search.select_dates'|trans }}</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#999" stroke-width="2">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                </div>
            </div>
            
            {# Calendar dropdown #}
            <div id="filterDatePicker" style="display: none; margin-top: 12px; background: #fff; border: 1px solid #e5e5e5; border-radius: 12px; padding: 16px; box-shadow: 0 8px 24px rgba(0,0,0,0.1);">
                {# Month navigation #}
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                    <button type="button" id="filterPrevMonth" style="width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; background: #f5f5f5; border: none; border-radius: 6px; cursor: pointer;">
                        <svg width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="#1a1a1a" stroke-width="2"><path d="M8 2L4 6L8 10"/></svg>
                    </button>
                    <span id="filterMonthYear" style="font-size: 0.9rem; font-weight: 500; color: #1a1a1a;"></span>
                    <button type="button" id="filterNextMonth" style="width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; background: #f5f5f5; border: none; border-radius: 6px; cursor: pointer;">
                        <svg width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="#1a1a1a" stroke-width="2"><path d="M4 2L8 6L4 10"/></svg>
                    </button>
                </div>
                
                {# Weekday headers #}
                <div style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; margin-bottom: 6px;">
                    <div style="text-align: center; font-size: 0.65rem; font-weight: 600; color: #999; padding: 4px;">L</div>
                    <div style="text-align: center; font-size: 0.65rem; font-weight: 600; color: #999; padding: 4px;">M</div>
                    <div style="text-align: center; font-size: 0.65rem; font-weight: 600; color: #999; padding: 4px;">M</div>
                    <div style="text-align: center; font-size: 0.65rem; font-weight: 600; color: #999; padding: 4px;">J</div>
                    <div style="text-align: center; font-size: 0.65rem; font-weight: 600; color: #999; padding: 4px;">V</div>
                    <div style="text-align: center; font-size: 0.65rem; font-weight: 600; color: #999; padding: 4px;">S</div>
                    <div style="text-align: center; font-size: 0.65rem; font-weight: 600; color: #999; padding: 4px;">D</div>
                </div>
                
                {# Calendar grid #}
                <div id="filterCalendarGrid" style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px;"></div>
                
                {# Selected dates display #}
                <div style="margin-top: 12px; padding-top: 12px; border-top: 1px solid #eee;">
                    <div style="display: flex; justify-content: space-between; font-size: 0.8rem;">
                        <span style="color: #666;">{{ 'noho.search.arrival'|trans }}: <strong id="filterArrivalDisplay" style="color: #1a1a1a;">-</strong></span>
                        <span style="color: #666;">{{ 'noho.search.departure'|trans }}: <strong id="filterDepartureDisplay" style="color: #1a1a1a;">-</strong></span>
                    </div>
                </div>
            </div>
        </div>
        
        {# Apply Button #}
        <button type="button" class="noho-btn-submit" style="width: 100%; padding: 14px; font-size: 0.85rem; font-weight: 500; letter-spacing: 0.05em; text-transform: uppercase; color: #fff; background: #1a1a1a; border: none; border-radius: 8px; cursor: pointer; transition: all 0.3s ease;">
            {{ 'noho.filters.apply'|trans }}
        </button>
        
        {# Reset Link #}
        <a href="{{ taxon ? path('sylius_shop_product_index', {slug: taxon.slug}) : path('sylius_shop_homepage') }}" style="display: block; text-align: center; margin-top: 12px; font-size: 0.85rem; color: #999 !important; text-decoration: none;">
            {{ 'noho.filters.reset'|trans }}
        </a>
    </div>
</aside>

<style>
.filter-btn:hover {
    border-color: #1a1a1a !important;
}
.filter-btn.active {
    background: #1a1a1a !important;
    color: #fff !important;
    border-color: #1a1a1a !important;
}
</style>

<script>
(function() {
    var filterCurrentMonth = new Date().getMonth();
    var filterCurrentYear = new Date().getFullYear();
    var filterSelectedStart = null;
    var filterSelectedEnd = null;
    var calendarOpen = false;
    
    var months = ['Janvier', 'Février', 'Mars', 'Avril', 'Mai', 'Juin', 'Juillet', 'Août', 'Septembre', 'Octobre', 'Novembre', 'Décembre'];
    
    function formatDateStr(year, month, day) {
        return year + '-' + String(month + 1).padStart(2, '0') + '-' + String(day).padStart(2, '0');
    }
    
    function formatDisplayDate(dateStr) {
        if (!dateStr) return '-';
        var parts = dateStr.split('-');
        return parts[2] + '/' + parts[1];
    }
    
    function toggleCalendar() {
        var picker = document.getElementById('filterDatePicker');
        if (picker) {
            calendarOpen = !calendarOpen;
            picker.style.display = calendarOpen ? 'block' : 'none';
        }
    }
    
    function changeMonth(delta) {
        filterCurrentMonth += delta;
        if (filterCurrentMonth > 11) {
            filterCurrentMonth = 0;
            filterCurrentYear++;
        } else if (filterCurrentMonth < 0) {
            filterCurrentMonth = 11;
            filterCurrentYear--;
        }
        renderFilterCalendar();
    }
    
    function selectDate(dateStr) {
        if (!filterSelectedStart || (filterSelectedStart && filterSelectedEnd)) {
            filterSelectedStart = dateStr;
            filterSelectedEnd = null;
        } else {
            if (dateStr < filterSelectedStart) {
                filterSelectedEnd = filterSelectedStart;
                filterSelectedStart = dateStr;
            } else {
                filterSelectedEnd = dateStr;
            }
        }
        
        var arrivalEl = document.getElementById('filterArrivalDisplay');
        var departureEl = document.getElementById('filterDepartureDisplay');
        var displayEl = document.getElementById('filterDateDisplay');
        
        if (arrivalEl) arrivalEl.textContent = formatDisplayDate(filterSelectedStart);
        if (departureEl) departureEl.textContent = formatDisplayDate(filterSelectedEnd);
        
        if (displayEl) {
            if (filterSelectedStart && filterSelectedEnd) {
                displayEl.textContent = formatDisplayDate(filterSelectedStart) + ' → ' + formatDisplayDate(filterSelectedEnd);
                displayEl.style.color = '#1a1a1a';
            } else if (filterSelectedStart) {
                displayEl.textContent = formatDisplayDate(filterSelectedStart) + ' → ...';
                displayEl.style.color = '#1a1a1a';
            }
        }
        
        renderFilterCalendar();
    }
    
    function renderFilterCalendar() {
        var monthYearEl = document.getElementById('filterMonthYear');
        var gridEl = document.getElementById('filterCalendarGrid');
        if (!monthYearEl || !gridEl) return;
        
        monthYearEl.textContent = months[filterCurrentMonth] + ' ' + filterCurrentYear;
        
        var firstDay = new Date(filterCurrentYear, filterCurrentMonth, 1);
        var lastDay = new Date(filterCurrentYear, filterCurrentMonth + 1, 0);
        var startDay = (firstDay.getDay() + 6) % 7;
        var today = new Date();
        today.setHours(0,0,0,0);
        
        gridEl.innerHTML = '';
        
        // Empty cells before first day
        for (var i = 0; i < startDay; i++) {
            var emptyCell = document.createElement('div');
            gridEl.appendChild(emptyCell);
        }
        
        // Day cells
        for (var day = 1; day <= lastDay.getDate(); day++) {
            var dateStr = formatDateStr(filterCurrentYear, filterCurrentMonth, day);
            var cellDate = new Date(filterCurrentYear, filterCurrentMonth, day);
            var isPast = cellDate < today;
            var isSelected = dateStr === filterSelectedStart || dateStr === filterSelectedEnd;
            var isInRange = false;
            
            if (filterSelectedStart && filterSelectedEnd) {
                isInRange = dateStr > filterSelectedStart && dateStr < filterSelectedEnd;
            }
            
            var cell = document.createElement('div');
            cell.textContent = day;
            cell.style.cssText = 'width: 100%; aspect-ratio: 1; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; border-radius: 4px; transition: all 0.15s;';
            
            if (isPast) {
                cell.style.color = '#ccc';
                cell.style.cursor = 'not-allowed';
            } else if (isSelected) {
                cell.style.background = '#1a1a1a';
                cell.style.color = '#fff';
                cell.style.cursor = 'pointer';
            } else if (isInRange) {
                cell.style.background = '#f0f0f0';
                cell.style.color = '#1a1a1a';
                cell.style.cursor = 'pointer';
            } else {
                cell.style.color = '#1a1a1a';
                cell.style.cursor = 'pointer';
            }
            
            if (!isPast) {
                (function(ds) {
                    cell.addEventListener('click', function(e) {
                        e.stopPropagation();
                        selectDate(ds);
                    });
                    cell.addEventListener('mouseenter', function() {
                        if (this.style.background !== 'rgb(26, 26, 26)') {
                            this.style.background = '#f5f5f5';
                        }
                    });
                    cell.addEventListener('mouseleave', function() {
                        if (this.style.background === 'rgb(245, 245, 245)') {
                            this.style.background = '';
                        }
                    });
                })(dateStr);
            }
            
            gridEl.appendChild(cell);
        }
    }
    
    // Event listeners
    document.addEventListener('DOMContentLoaded', function() {
        var trigger = document.getElementById('filterDateTrigger');
        var prevBtn = document.getElementById('filterPrevMonth');
        var nextBtn = document.getElementById('filterNextMonth');
        
        if (trigger) {
            trigger.addEventListener('click', function(e) {
                e.stopPropagation();
                toggleCalendar();
            });
        }
        
        if (prevBtn) {
            prevBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                changeMonth(-1);
            });
        }
        
        if (nextBtn) {
            nextBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                changeMonth(1);
            });
        }
        
        // Close calendar when clicking outside
        document.addEventListener('click', function(e) {
            var picker = document.getElementById('filterDatePicker');
            var trigger = document.getElementById('filterDateTrigger');
            if (picker && calendarOpen && !picker.contains(e.target) && !trigger.contains(e.target)) {
                calendarOpen = false;
                picker.style.display = 'none';
            }
        });
        
        // Filter buttons toggle
        document.querySelectorAll('.filter-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
                this.classList.toggle('active');
            });
        });
        
        // Initialize calendar
        renderFilterCalendar();
    });
})();
</script>
