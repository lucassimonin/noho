{# Sidebar filters — partial list refresh via noho-catalog-partial-update.js #}
{% set taxon = noho_current_taxon() %}
{% set list_slug = app.request.attributes.get('slug')|default('catalogue') %}
{% set crit = app.request.get('criteria') ?? [] %}
{% set voyageurs_val = (crit['voyageurs'] ?? {})['value']|default('') %}
{% set chambres_val = (crit['chambres'] ?? {})['value']|default('') %}
{% set price_bucket_val = (crit['noho_price'] ?? {})['value']|default('') %}
{% set noho_ds = app.request.get('noho_date_start')|default('') %}
{% set noho_de = app.request.get('noho_date_end')|default('') %}

<aside class="noho-list-sidebar">
    <div style="background: #fff; border-radius: 12px; padding: 28px; box-shadow: 0 2px 12px rgba(0,0,0,0.06);">
        <div class="noho-filters-header" id="filtersToggle">
            <h3 style="font-family: Georgia, serif; font-size: 1.1rem; font-weight: 600; color: #1a1a1a; margin: 0;">{{ 'noho.filters.title'|trans }}</h3>
            <svg class="noho-filters-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1a1a1a" stroke-width="2">
                <path d="M6 9l6 6 6-6"/>
            </svg>
        </div>

        <div class="noho-filters-content" id="filtersContent">
            {% include 'components/Shop/CatalogFilters.html.twig' with {
                voyageurs: voyageurs_val,
                chambres: chambres_val,
                priceBucket: price_bucket_val,
                dateStart: noho_ds,
                dateEnd: noho_de,
            } only %}

            <a href="{{ path('sylius_shop_product_index', { slug: list_slug, _locale: app.request.locale }) }}" style="display: block; text-align: center; margin-top: 12px; font-size: 0.85rem; color: #999 !important; text-decoration: none;">
                {{ 'noho.filters.reset'|trans }}
            </a>
        </div>
    </div>
</aside>
