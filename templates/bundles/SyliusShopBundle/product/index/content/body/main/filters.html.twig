{# Top bar with count and sorting - No Search #}
{% set resources = hookable_metadata.context.resources %}
{% set total = resources.data.nbResults is defined ? resources.data.nbResults : resources.data|length %}

<div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 32px; padding-bottom: 20px; border-bottom: 1px solid #e5e5e5;">
    <span style="font-size: 0.95rem; color: #666;">{{ total }} {{ total > 1 ? 'noho.filters.properties'|trans : 'noho.filters.property'|trans }}</span>
    
    <div style="display: flex; align-items: center; gap: 16px;">
        <span style="font-size: 0.85rem; color: #999;">{{ 'noho.filters.sort_by'|trans }} :</span>
        <select style="padding: 8px 32px 8px 12px; font-size: 0.9rem; color: #1a1a1a; background: #fff url('data:image/svg+xml;utf8,<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"12\" height=\"6\" viewBox=\"0 0 12 6\"><path d=\"M0 0l6 6 6-6z\" fill=\"%23666\"/></svg>') no-repeat right 12px center; border: 1px solid #e5e5e5; border-radius: 6px; cursor: pointer; appearance: none; -webkit-appearance: none;">
            <option value="position">{{ 'noho.filters.position'|trans }}</option>
            <option value="price_asc">{{ 'noho.filters.price_asc'|trans }}</option>
            <option value="price_desc">{{ 'noho.filters.price_desc'|trans }}</option>
            <option value="name">{{ 'noho.filters.name'|trans }}</option>
            <option value="newest">{{ 'noho.filters.newest'|trans }}</option>
        </select>
    </div>
</div>
