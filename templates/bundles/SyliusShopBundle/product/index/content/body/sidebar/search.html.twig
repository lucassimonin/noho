{# Sidebar Search Filter #}
{% set resources = hookable_metadata.context.resources|default(null) %}

<div style="margin-bottom: 24px;">
    <h4 style="font-size: 0.7rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: #999; margin: 0 0 12px;">Recherche</h4>
    
    <form method="get" action="" style="position: relative;">
        <input type="text" 
               name="criteria[search][value]" 
               placeholder="Rechercher..."
               value="{{ app.request.get('criteria').search.value|default('') }}"
               style="width: 100%; padding: 12px 40px 12px 14px; font-size: 0.9rem; color: #1a1a1a; background: #f8f8f8; border: 1px solid #e5e5e5; border-radius: 6px; outline: none; transition: border-color 0.2s;"
               onfocus="this.style.borderColor='#1a1a1a';"
               onblur="this.style.borderColor='#e5e5e5';">
        <button type="submit" style="position: absolute; right: 8px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; padding: 8px; color: #666;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="M21 21l-4.35-4.35"></path>
            </svg>
        </button>
    </form>
</div>
