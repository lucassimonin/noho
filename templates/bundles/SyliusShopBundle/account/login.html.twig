{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% form_theme form '@SyliusShop/form/theme.html.twig' %}

{% block title %}{{ 'sylius.ui.customer_login'|trans }} | {{ parent() }}{% endblock %}

{% block content %}
<div style="display: flex; min-height: calc(100vh - 80px);">
    
    {# Left - Image #}
    <div style="flex: 1; display: none; background: #1a1a1a; position: relative; overflow: hidden;" class="login-image-panel">
        <img src="https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80" 
             alt="Luxury property" 
             style="width: 100%; height: 100%; object-fit: cover; opacity: 0.85;">
        <div style="position: absolute; inset: 0; background: linear-gradient(135deg, rgba(26,26,26,0.4) 0%, rgba(26,26,26,0.7) 100%);"></div>
        <div style="position: absolute; bottom: 60px; left: 60px; right: 60px; color: #fff;">
            <p style="font-family: Georgia, serif; font-size: 1.75rem; font-weight: 400; line-height: 1.4; margin: 0 0 16px;">
                "Un service d'exception pour des séjours inoubliables"
            </p>
            <span style="font-size: 0.85rem; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.7;">Noho Conciergerie</span>
        </div>
    </div>
    
    {# Right - Form #}
    <div style="flex: 1; display: flex; align-items: center; justify-content: center; padding: 60px 24px; background: #fff;">
        <div style="width: 100%; max-width: 400px;">
            
            {# Logo/Brand #}
            <div style="text-align: center; margin-bottom: 48px;">
                <a href="{{ path('sylius_shop_homepage') }}" style="text-decoration: none;">
                    <span style="font-family: Georgia, serif; font-size: 1.75rem; font-weight: 400; color: #1a1a1a !important; letter-spacing: 0.02em;">NOHO</span>
                </a>
                <p style="font-size: 0.9rem; color: #888; margin-top: 8px;">Connectez-vous à votre compte</p>
            </div>
            
            {% if last_error %}
                <div style="background: #fff5f5; border-left: 3px solid #e53935; padding: 14px 16px; margin-bottom: 24px; color: #c62828; font-size: 0.9rem; border-radius: 0 6px 6px 0;">
                    {{ last_error.messageKey|trans(last_error.messageData, 'security') }}
                </div>
            {% endif %}
            
            <form action="{{ path('sylius_shop_login_check') }}" method="post">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                
                <div style="margin-bottom: 20px;">
                    <label style="display: block; font-size: 0.85rem; font-weight: 500; color: #333; margin-bottom: 8px;">{{ 'sylius.ui.email'|trans }}</label>
                    <input type="email" name="_username" required 
                           placeholder="votre@email.com"
                           style="width: 100%; padding: 14px 16px; font-size: 0.95rem; color: #1a1a1a; background: #f8f8f8; border: 1px solid transparent; border-radius: 8px; outline: none; transition: all 0.2s;" 
                           onfocus="this.style.background='#fff'; this.style.borderColor='#1a1a1a';" 
                           onblur="this.style.background='#f8f8f8'; this.style.borderColor='transparent';">
                </div>
                
                <div style="margin-bottom: 20px;">
                    <label style="display: block; font-size: 0.85rem; font-weight: 500; color: #333; margin-bottom: 8px;">{{ 'sylius.ui.password'|trans }}</label>
                    <input type="password" name="_password" required 
                           placeholder="••••••••"
                           style="width: 100%; padding: 14px 16px; font-size: 0.95rem; color: #1a1a1a; background: #f8f8f8; border: 1px solid transparent; border-radius: 8px; outline: none; transition: all 0.2s;" 
                           onfocus="this.style.background='#fff'; this.style.borderColor='#1a1a1a';" 
                           onblur="this.style.background='#f8f8f8'; this.style.borderColor='transparent';">
                </div>
                
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 28px;">
                    <label style="display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: #666; cursor: pointer;">
                        <input type="checkbox" name="_remember_me" style="width: 16px; height: 16px; accent-color: #1a1a1a;">
                        {{ 'sylius.ui.remember_me'|trans }}
                    </label>
                    <a href="{{ path('sylius_shop_request_password_reset_token') }}" style="font-size: 0.85rem; color: #666 !important; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#1a1a1a'" onmouseout="this.style.color='#666'">{{ 'sylius.ui.forgot_password'|trans }}</a>
                </div>
                
                <button type="submit" class="noho-btn-submit" style="width: 100%; padding: 16px; font-size: 0.9rem; font-weight: 500; letter-spacing: 0.05em; text-transform: uppercase; color: #fff; background: #1a1a1a; border: none; border-radius: 8px; cursor: pointer; transition: all 0.3s ease;">
                    {{ 'sylius.ui.login'|trans }}
                </button>
            </form>
            
            <div style="margin-top: 40px; text-align: center;">
                <span style="font-size: 0.9rem; color: #888;">Pas encore de compte ?</span>
                <a href="{{ path('sylius_shop_register') }}" style="font-size: 0.9rem; color: #1a1a1a !important; font-weight: 500; text-decoration: none; margin-left: 6px; border-bottom: 1px solid #1a1a1a; padding-bottom: 1px; transition: opacity 0.2s;" onmouseover="this.style.opacity='0.6'" onmouseout="this.style.opacity='1'">
                    {{ 'sylius.ui.register'|trans }}
                </a>
            </div>
        </div>
    </div>
</div>

<style>
@media (min-width: 900px) {
    .login-image-panel {
        display: block !important;
    }
}
</style>
{% endblock %}
