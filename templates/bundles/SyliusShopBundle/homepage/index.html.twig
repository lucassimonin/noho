{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block content %}
{# Hero Section #}
<section class="noho-hero" style="background-image: url('https://images.unsplash.com/photo-1520250497591-112f2f40a3f4?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80');">
    <div class="noho-hero-content">
        <h1>{{ 'noho.hero.title'|trans|raw }}</h1>
        <p>{{ 'noho.hero.subtitle'|trans }}</p>
        <a href="#nos-services" class="noho-btn">{{ 'noho.hero.cta'|trans }}</a>
    </div>
</section>

{# Search box — styles: noho-override.css (.noho-home-*) #}
<div class="noho-search-wrapper">
    <div class="noho-search-box">
        {{ form_start(catalog_search_form, {
            action: path('noho_shop_catalog_search', { _locale: app.request.locale }),
            method: 'POST',
            attr: { class: 'noho-catalog-search-form', id: 'noho-catalog-search-form' }
        }) }}
            {{ form_widget(catalog_search_form._token) }}
            <div class="noho-home-search-grid">
                <div>
                    <label class="noho-home-field-label" for="{{ catalog_search_form.taxonSlug.vars.id }}">{{ 'noho.search.destination'|trans }}</label>
                    {{ form_widget(catalog_search_form.taxonSlug, { attr: { class: 'noho-home-search-select' } }) }}
                    {{ form_errors(catalog_search_form.taxonSlug) }}
                </div>

                <div>
                    <label class="noho-home-field-label" for="{{ catalog_search_form.travelers.vars.id }}">{{ 'noho.search.travelers'|trans }}</label>
                    {{ form_widget(catalog_search_form.travelers, { attr: { class: 'noho-home-search-select' } }) }}
                    {{ form_errors(catalog_search_form.travelers) }}
                </div>

                <div>
                    <label class="noho-home-field-label" for="{{ catalog_search_form.bedrooms.vars.id }}">{{ 'noho.search.rooms'|trans }}</label>
                    {{ form_widget(catalog_search_form.bedrooms, { attr: { class: 'noho-home-search-select' } }) }}
                    {{ form_errors(catalog_search_form.bedrooms) }}
                </div>

                <div class="noho-home-search-date-wrap">
                    <label class="noho-home-field-label" for="datePickerTrigger">{{ 'noho.search.dates'|trans }}</label>
                    <button type="button" id="datePickerTrigger" class="noho-home-search-date-trigger" aria-expanded="false" aria-haspopup="dialog">
                        <span class="noho-home-search-date-trigger__icon" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                                <rect x="3" y="5" width="18" height="16" rx="2.5"></rect>
                                <path d="M3 10h18M8 3v4M16 3v4"></path>
                            </svg>
                        </span>
                        <span id="dateDisplay" class="noho-home-search-date-trigger__text">{{ 'noho.search.select_dates'|trans }}</span>
                    </button>
                    {{ form_widget(catalog_search_form.dateStart) }}
                    {{ form_widget(catalog_search_form.dateEnd) }}

                    <div id="datePickerDropdown" class="noho-home-date-dropdown" role="dialog" aria-modal="true" aria-label="{{ 'noho.search.dates'|trans }}">
                        <div class="noho-home-date-nav">
                            <button type="button" id="homePrevMonth" class="noho-home-date-nav__btn" aria-label="Mois précédent">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
                            </button>
                            <h4 id="homeCalendarMonth" class="noho-home-date-nav__title"></h4>
                            <button type="button" id="homeNextMonth" class="noho-home-date-nav__btn" aria-label="Mois suivant">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
                            </button>
                        </div>

                        <div class="noho-home-cal-weekdays" aria-hidden="true">
                            <span>{{ 'noho.calendar.days.mon'|trans }}</span>
                            <span>{{ 'noho.calendar.days.tue'|trans }}</span>
                            <span>{{ 'noho.calendar.days.wed'|trans }}</span>
                            <span>{{ 'noho.calendar.days.thu'|trans }}</span>
                            <span>{{ 'noho.calendar.days.fri'|trans }}</span>
                            <span>{{ 'noho.calendar.days.sat'|trans }}</span>
                            <span>{{ 'noho.calendar.days.sun'|trans }}</span>
                        </div>
                        <div id="homeCalendarDays" class="noho-home-cal-grid"></div>

                        <div class="noho-home-date-summary">
                            <div class="noho-home-date-summary__col">
                                <div class="noho-home-date-summary__k">{{ 'noho.search.arrival'|trans }}</div>
                                <div id="arrivalDisplay" class="noho-home-date-summary__v">-</div>
                            </div>
                            <div class="noho-home-date-summary__col">
                                <div class="noho-home-date-summary__k">{{ 'noho.search.departure'|trans }}</div>
                                <div id="departureDisplay" class="noho-home-date-summary__v">-</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div>
                    <span class="noho-home-field-label" style="visibility: hidden; user-select: none;" aria-hidden="true">&nbsp;</span>
                    <button type="submit" class="noho-btn-submit noho-home-search-submit">{{ 'noho.search.search'|trans }}</button>
                </div>
            </div>
        {{ form_end(catalog_search_form, { render_rest: false }) }}
    </div>
</div>

<script>
(function() {
    var dropdown = document.getElementById('datePickerDropdown');
    var trigger = document.getElementById('datePickerTrigger');
    var currentMonth, currentYear;
    var selectedStart = null;
    var selectedEnd = null;
    var monthNames = [
        '{{ 'noho.calendar.months.january'|trans|e('js') }}',
        '{{ 'noho.calendar.months.february'|trans|e('js') }}',
        '{{ 'noho.calendar.months.march'|trans|e('js') }}',
        '{{ 'noho.calendar.months.april'|trans|e('js') }}',
        '{{ 'noho.calendar.months.may'|trans|e('js') }}',
        '{{ 'noho.calendar.months.june'|trans|e('js') }}',
        '{{ 'noho.calendar.months.july'|trans|e('js') }}',
        '{{ 'noho.calendar.months.august'|trans|e('js') }}',
        '{{ 'noho.calendar.months.september'|trans|e('js') }}',
        '{{ 'noho.calendar.months.october'|trans|e('js') }}',
        '{{ 'noho.calendar.months.november'|trans|e('js') }}',
        '{{ 'noho.calendar.months.december'|trans|e('js') }}'
    ];
    var selectDatesText = '{{ 'noho.search.select_dates'|trans|e('js') }}';
    
    var now = new Date();
    currentMonth = now.getMonth();
    currentYear = now.getFullYear();

    /** ES5-safe (padStart missing on older Safari / WebViews) */
    function pad2(n) {
        var s = String(n);
        return s.length < 2 ? '0' + s : s;
    }
    
    function formatDate(year, month, day) {
        return year + '-' + pad2(month + 1) + '-' + pad2(day);
    }
    
    function formatDisplayDate(dateStr) {
        if (!dateStr) return '-';
        var parts = dateStr.split('-');
        var mi = parseInt(parts[1], 10) - 1;
        var label = monthNames[mi];
        if (!label || !parts[2]) return '-';
        return parseInt(parts[2], 10) + ' ' + String(label).substring(0, 3);
    }

    function homeDateHiddenStart() {
        return document.getElementById('homeArrivalDate')
            || document.querySelector('input[name="catalog_search[dateStart]"]');
    }
    function homeDateHiddenEnd() {
        return document.getElementById('homeDepartureDate')
            || document.querySelector('input[name="catalog_search[dateEnd]"]');
    }
    
    function setHomeDateDropdownOpen(open) {
        if (!dropdown || !trigger) return;
        dropdown.classList.toggle('is-open', open);
        trigger.classList.toggle('is-open', open);
        trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    function updateDisplay() {
        var display = document.getElementById('dateDisplay');
        var arrDisplay = document.getElementById('arrivalDisplay');
        var depDisplay = document.getElementById('departureDisplay');
        if (!display || !arrDisplay || !depDisplay) return;
        
        if (selectedStart && selectedEnd) {
            display.textContent = formatDisplayDate(selectedStart) + ' → ' + formatDisplayDate(selectedEnd);
        } else if (selectedStart) {
            display.textContent = formatDisplayDate(selectedStart) + ' → ...';
        } else {
            display.textContent = selectDatesText;
        }
        display.classList.toggle('is-filled', !!(selectedStart || selectedEnd));
        
        arrDisplay.textContent = formatDisplayDate(selectedStart);
        depDisplay.textContent = formatDisplayDate(selectedEnd);
        
        var hS = homeDateHiddenStart();
        var hE = homeDateHiddenEnd();
        if (hS) hS.value = selectedStart || '';
        if (hE) hE.value = selectedEnd || '';
    }
    
    function renderCalendar() {
        var monthTitle = document.getElementById('homeCalendarMonth');
        var grid = document.getElementById('homeCalendarDays');
        if (!monthTitle || !grid) return;

        var firstDay = new Date(currentYear, currentMonth, 1);
        var lastDay = new Date(currentYear, currentMonth + 1, 0);
        /* Monday = first column (headers L … D) */
        var padCount = (firstDay.getDay() + 6) % 7;
        var daysInMonth = lastDay.getDate();
        var today = new Date();
        today.setHours(0,0,0,0);
        
        monthTitle.textContent = monthNames[currentMonth] + ' ' + currentYear;
        
        var html = '';
        for (var i = 0; i < padCount; i++) {
            html += '<div class="home-cal-day home-cal-day--pad" aria-hidden="true"></div>';
        }
        
        for (var day = 1; day <= daysInMonth; day++) {
            var date = new Date(currentYear, currentMonth, day, 12, 0, 0);
            var dateStr = formatDate(currentYear, currentMonth, day);
            var isPast = date < today;
            var isSelected = (selectedStart && dateStr === selectedStart) || (selectedEnd && dateStr === selectedEnd);
            var isInRange = selectedStart && selectedEnd && dateStr > selectedStart && dateStr < selectedEnd;
            
            var classes = 'home-cal-day';
            if (isPast) classes += ' disabled';
            if (isSelected) classes += ' selected';
            if (isInRange) classes += ' in-range';
            
            html += '<div class="' + classes + '" data-date="' + dateStr + '">' + day + '</div>';
        }
        
        grid.innerHTML = html;
        
        grid.querySelectorAll('.home-cal-day[data-date]').forEach(function(el) {
            el.addEventListener('click', function(e) {
                e.stopPropagation();
                var dateStr = this.getAttribute('data-date');
                if (!dateStr) return;
                
                if (!selectedStart || (selectedStart && selectedEnd)) {
                    selectedStart = dateStr;
                    selectedEnd = null;
                } else {
                    if (dateStr > selectedStart) {
                        selectedEnd = dateStr;
                    } else {
                        selectedStart = dateStr;
                    }
                }
                updateDisplay();
                renderCalendar();
            });
        });
    }
    
    if (dropdown) {
        dropdown.addEventListener('click', function(e) {
            e.stopPropagation();
        });
    }

    if (trigger && dropdown) {
        trigger.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            var open = !dropdown.classList.contains('is-open');
            setHomeDateDropdownOpen(open);
            if (open) renderCalendar();
        });
    }
    
    document.addEventListener('click', function(e) {
        if (!dropdown || !dropdown.classList.contains('is-open')) return;
        if (trigger && trigger.contains(e.target)) return;
        if (dropdown.contains(e.target)) return;
        setHomeDateDropdownOpen(false);
    });
    
    var homePrevMonth = document.getElementById('homePrevMonth');
    var homeNextMonth = document.getElementById('homeNextMonth');
    if (homePrevMonth) {
        homePrevMonth.addEventListener('click', function(e) {
            e.stopPropagation();
            currentMonth--;
            if (currentMonth < 0) { currentMonth = 11; currentYear--; }
            renderCalendar();
        });
    }
    if (homeNextMonth) {
        homeNextMonth.addEventListener('click', function(e) {
            e.stopPropagation();
            currentMonth++;
            if (currentMonth > 11) { currentMonth = 0; currentYear++; }
            renderCalendar();
        });
    }

    updateDisplay();
})();
</script>

{# How it works #}
<section class="noho-section" style="padding-top: 100px;">
    <h2 class="noho-section-title">{{ 'noho.how_it_works.title'|trans }}</h2>
    <div class="noho-container">
        <div class="noho-pillars">
            <div>
                <h3 class="noho-pillar-title">{{ 'noho.how_it_works.selection_title'|trans }}</h3>
                <p class="noho-pillar-text">{{ 'noho.how_it_works.selection_text'|trans }}</p>
            </div>
            <div>
                <h3 class="noho-pillar-title">{{ 'noho.how_it_works.hospitality_title'|trans }}</h3>
                <p class="noho-pillar-text">{{ 'noho.how_it_works.hospitality_text'|trans }}</p>
            </div>
            <div>
                <h3 class="noho-pillar-title">{{ 'noho.how_it_works.serenity_title'|trans }}</h3>
                <p class="noho-pillar-text">{{ 'noho.how_it_works.serenity_text'|trans }}</p>
            </div>
        </div>
    </div>
</section>

{# Destination Banner #}
<section class="noho-banner" style="background-image: url('https://images.unsplash.com/photo-1511739001486-6bfe10ce785f?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80');">
    <div class="noho-banner-content">
        <h2 class="noho-banner-title">Paris</h2>
        <a href="{{ path('sylius_shop_product_index', {slug: 'catalogue/france/paris'}) }}" class="noho-btn-outline">{{ 'noho.discover'|trans }}</a>
    </div>
</section>

{# Latest Properties #}
<section id="nos-services" class="noho-section noho-section-light" style="scroll-margin-top: 32px;">
    <h2 class="noho-section-title">{{ 'noho.latest_properties.title'|trans }}</h2>
    <div class="noho-container">
        <div {{ sylius_test_html_attribute('latest-products') }}>
            {{ component('sylius_shop:product:list', { limit: 4, template: '@SyliusShop/product/services_grid.html.twig' }) }}
        </div>
    </div>
</section>

{# About #}
<section class="noho-section">
    <h2 class="noho-section-title">{{ 'noho.concierge.title'|trans }}</h2>
    <div class="noho-container-sm" style="text-align: center;">
        <p style="font-size: 1.05rem; line-height: 1.8; color: #666; margin-bottom: 32px;">
            {{ 'noho.concierge.text'|trans }}
        </p>
        <a href="{{ path('noho_experiences', {_locale: app.request.locale}) }}" class="noho-btn-dark">{{ 'noho.concierge.cta'|trans }}</a>
    </div>
</section>

{# Trust Badges #}
<section class="noho-section noho-section-light">
    <h2 class="noho-section-title">{{ 'noho.trust.title'|trans }}</h2>
    <div class="noho-container">
        <div class="noho-trust-grid">
            <div class="noho-trust-item">
                <h3 class="noho-trust-title">{{ 'noho.trust.support_title'|trans }}</h3>
                <p class="noho-trust-text">{{ 'noho.trust.support_text'|trans }}</p>
            </div>
            <div class="noho-trust-item">
                <h3 class="noho-trust-title">{{ 'noho.trust.qualified_title'|trans }}</h3>
                <p class="noho-trust-text">{{ 'noho.trust.qualified_text'|trans }}</p>
            </div>
            <div class="noho-trust-item">
                <h3 class="noho-trust-title">{{ 'noho.trust.secure_title'|trans }}</h3>
                <p class="noho-trust-text">{{ 'noho.trust.secure_text'|trans }}</p>
            </div>
            <div class="noho-trust-item">
                <h3 class="noho-trust-title">{{ 'noho.trust.custom_title'|trans }}</h3>
                <p class="noho-trust-text">{{ 'noho.trust.custom_text'|trans }}</p>
            </div>
        </div>
    </div>
</section>
{% endblock %}
