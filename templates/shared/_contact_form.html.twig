{#
  Formulaire de contact mutualisé (Espace Propriétaires, Expériences, etc.)
  Variables: form_id_prefix (ex: 'ep', 'exp'), form_action (optionnel, défaut #), submit_label (optionnel)
#}
{% set form_id_prefix = form_id_prefix|default('contact') %}
{% set form_action = form_action|default('#') %}
{% set submit_label = submit_label|default('Envoyer'|trans) %}
<div class="noho-contact-form">
    <form method="post" action="{{ form_action }}" class="needs-validation" novalidate>
        <div class="mb-3">
            <label for="{{ form_id_prefix }}-nom" class="form-label">{{ 'Nom'|trans }}</label>
            <input type="text" id="{{ form_id_prefix }}-nom" name="nom" class="form-control" required>
        </div>
        <div class="mb-3">
            <label for="{{ form_id_prefix }}-telephone" class="form-label">{{ 'Numéro de téléphone'|trans }}</label>
            <input type="tel" id="{{ form_id_prefix }}-telephone" name="telephone" class="form-control">
        </div>
        <div class="mb-4">
            <label for="{{ form_id_prefix }}-email" class="form-label">Email</label>
            <input type="email" id="{{ form_id_prefix }}-email" name="email" class="form-control" required>
        </div>
        <button type="submit" class="btn">{{ submit_label }}</button>
    </form>
</div>
